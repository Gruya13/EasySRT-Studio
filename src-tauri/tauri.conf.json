{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasySRT Studio",
  "version": "0.4.0",
  "identifier": "com.easysrt.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EasySRT Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": false,
        "shadow": true,
        "maximized": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; media-src 'self' blob: asset: http://asset.localhost https://asset.localhost; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost asset: http://asset.localhost https://asset.localhost; font-src 'self' data:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'",
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": [
      "nsis",
      "appimage"
    ],
    "resources": [
      "resources/catalog.json",
      "resources/vcruntime/*"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNTJEMDNFQjRFQjAzREUKUldUZUErdTBQdEJTdW02aXhrMFRONUNBWnhKOC9WV2pmbFJYNENieTBNREFKRFQrcGpqdEU0eloK",
      "endpoints": [
        "https://easysrt-telemetry.ig-systems.rs/v1/update/latest.json?target={{target}}&arch={{arch}}&current={{current_version}}",
        "https://github.com/Gruya13/EasySRT-Studio/releases/latest/download/latest.json"
      ]
    }
  }
}
