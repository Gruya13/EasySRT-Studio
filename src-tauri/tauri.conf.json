{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EasySRT Studio",
  "version": "0.3.1",
  "identifier": "com.easysrt.studio",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "EasySRT Studio",
        "width": 1280,
        "height": 840,
        "minWidth": 960,
        "minHeight": 640,
        "maximized": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis", "appimage"],
    "resources": ["resources/catalog.json", "resources/vcruntime/*"],
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh",
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJBNTJEMDNFQjRFQjAzREUKUldUZUErdTBQdEJTdW02aXhrMFRONUNBWnhKOC9WV2pmbFJYNENieTBNREFKRFQrcGpqdEU0eloK",
      "endpoints": [
        "https://github.com/Gruya13/EasySRT-Studio/releases/latest/download/latest.json"
      ]
    }
  }
}
